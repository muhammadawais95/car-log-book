@inherits LayoutComponentBase
@inject CarLogBook.Infrastructure.ThemeService Theme
@implements IDisposable

<div class="page" data-theme="@Theme.CurrentTheme">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <span></span>
            <button class="theme-toggle" @onclick="Theme.ToggleTheme" title="Toggle theme">
                @(Theme.IsDarkMode ? "☀️" : "🌙")
            </button>
        </div>
        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.OnThemeChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Theme.OnThemeChanged -= StateHasChanged;
    }
}
