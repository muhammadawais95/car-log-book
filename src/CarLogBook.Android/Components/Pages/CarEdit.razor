@page "/cars/edit/{Id:guid}"
@inject ICarService CarService
@inject NavigationManager Navigation

<h3>@(isNew ? "Add Car" : "Edit Car")</h3>

@if (car == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="car" OnValidSubmit="HandleValidSubmit">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="car.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Make</label>
            <InputText class="form-control" @bind-Value="car.Manufacturer" />
        </div>
        <div class="mb-3">
            <label class="form-label">Model</label>
            <InputText class="form-control" @bind-Value="car.Model" />
        </div>
        <div class="mb-3">
            <label class="form-label">Year</label>
            <InputText class="form-control" @bind-Value="car.Year" />
        </div>
        <div class="mb-3">
            <label class="form-label">License Plate</label>
            <InputText class="form-control" @bind-Value="car.LicensePlate" />
        </div>
        <div class="mb-3">
            <label class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="car.IsArchived" />
                Archived
            </label>
        </div>
        
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Car car = new() { Id = Guid.NewGuid(), Name = "" };
    private bool isNew;

    protected override async Task OnInitializedAsync()
    {
        isNew = Id == Guid.Empty || Id == new Guid();
        
        if (!isNew)
        {
            var existing = await CarService.GetByIdAsync(Id);
            if (existing != null)
            {
                car = new Car 
                { 
                    Id = existing.Id, 
                    Name = existing.Name,
                    Manufacturer = existing.Manufacturer,
                    Model = existing.Model,
                    Year = existing.Year,
                    LicensePlate = existing.LicensePlate,
                    IsArchived = existing.IsArchived
                };
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isNew)
        {
            await CarService.CreateAsync(car);
        }
        else
        {
            await CarService.UpdateAsync(car);
        }

        Navigation.NavigateTo("/cars");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/cars");
    }
}
