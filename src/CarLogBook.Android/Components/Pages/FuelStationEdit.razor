@page "/fuelstations/edit/{Id:guid}"
@inject IFuelStationService FuelStationService
@inject NavigationManager Navigation

<h3>@(isNew ? "Add Fuel Station" : "Edit Fuel Station")</h3>

@if (fuelStation == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="fuelStation" OnValidSubmit="HandleValidSubmit">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="fuelStation.Name" />
        </div>
        
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private FuelStation fuelStation = new() { Id = Guid.NewGuid(), Name = "" };
    private bool isNew;

    protected override async Task OnInitializedAsync()
    {
        isNew = Id == Guid.Empty || Id == new Guid();
        
        if (!isNew)
        {
            var existing = await FuelStationService.GetByIdAsync(Id);
            if (existing != null)
            {
                fuelStation = new FuelStation { Id = existing.Id, Name = existing.Name };
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isNew)
        {
            await FuelStationService.CreateAsync(fuelStation);
        }
        else
        {
            await FuelStationService.UpdateAsync(fuelStation);
        }

        Navigation.NavigateTo("/fuelstations");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/fuelstations");
    }
}
