@page "/maintenance/edit/{Id:guid}"
@inject IMaintenanceEventService MaintenanceEventService
@inject IMaintenanceCategoryService MaintenanceCategoryService
@inject ICarService CarService
@inject NavigationManager Navigation

<h3>@(isNew ? "Add Maintenance Event" : "Edit Maintenance Event")</h3>

@if (maintenanceEvent == null || cars == null || categories == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="maintenanceEvent" OnValidSubmit="HandleValidSubmit">
        <div class="mb-3">
            <label class="form-label">Car</label>
            <select class="form-control" @bind="maintenanceEvent.CarId">
                <option value="">Select Car</option>
                @foreach (var car in cars)
                {
                    <option value="@car.Id">@car.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Date</label>
            <InputDate class="form-control" @bind-Value="localDate" />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-control" @bind="maintenanceEvent.CategoryId">
                <option value="">Select Category</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Odometer (km)</label>
            <InputNumber class="form-control" @bind-Value="odometer" />
        </div>
        <div class="mb-3">
            <label class="form-label">Cost</label>
            <InputNumber class="form-control" @bind-Value="cost" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <InputText class="form-control" @bind-Value="maintenanceEvent.Notes" />
        </div>
        
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private MaintenanceEvent maintenanceEvent = new() 
    { 
        Id = Guid.NewGuid(), 
        CarId = Guid.Empty,
        CategoryId = Guid.Empty,
        DateUtc = DateTime.UtcNow,
        Notes = ""
    };
    private bool isNew;
    private DateTime localDate = DateTime.Now;
    private decimal odometer;
    private decimal cost;
    private List<Car>? cars;
    private List<MaintenanceCategory>? categories;

    protected override async Task OnInitializedAsync()
    {
        cars = (await CarService.GetAllAsync()).ToList();
        categories = (await MaintenanceCategoryService.GetAllAsync()).ToList();

        isNew = Id == Guid.Empty || Id == new Guid();
        
        if (!isNew)
        {
            var existing = await MaintenanceEventService.GetByIdAsync(Id);
            if (existing != null)
            {
                maintenanceEvent = existing;
                localDate = existing.DateUtc.ToLocalTime();
                odometer = existing.Odometer?.Kilometers ?? 0;
                cost = existing.Cost?.Amount ?? 0;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        maintenanceEvent.DateUtc = localDate.ToUniversalTime();
        
        if (odometer > 0)
            maintenanceEvent.Odometer = new OdometerReading(odometer);
        if (cost > 0)
            maintenanceEvent.Cost = new Money(cost, "PKR");

        if (isNew)
        {
            await MaintenanceEventService.CreateAsync(maintenanceEvent);
        }
        else
        {
            await MaintenanceEventService.UpdateAsync(maintenanceEvent);
        }

        Navigation.NavigateTo("/maintenance");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/maintenance");
    }
}
