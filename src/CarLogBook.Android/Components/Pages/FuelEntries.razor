@page "/fuelentries"
@inject IFuelEntryService FuelEntryService
@inject IFuelTypeService FuelTypeService
@inject IFuelStationService FuelStationService
@inject ICarService CarService
@inject NavigationManager Navigation

<h3>Fuel Entries</h3>

<p>
    <a href="/fuelentries/edit/new" class="btn btn-primary">Add New Fuel Entry</a>
</p>

@if (fuelEntries == null)
{
    <p>Loading...</p>
}
else if (!fuelEntries.Any())
{
    <p>No fuel entries found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Car</th>
                <th>Fuel Type</th>
                <th>Station</th>
                <th>Odometer</th>
                <th>Volume</th>
                <th>Cost</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in fuelEntries)
            {
                <tr>
                    <td>@entry.DateUtc.ToLocalTime().ToString("g")</td>
                    <td>@GetCarName(entry.CarId)</td>
                    <td>@GetFuelTypeName(entry.FuelTypeId)</td>
                    <td>@GetFuelStationName(entry.FuelStationId)</td>
                    <td>@entry.Odometer?.Kilometers</td>
                    <td>@entry.Volume?.Liters</td>
                    <td>@entry.Cost?.Amount</td>
                    <td>
                        <a href="/fuelentries/edit/@entry.Id" class="btn btn-sm btn-primary">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteFuelEntry(entry.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<FuelEntry>? fuelEntries;
    private List<Car>? cars;
    private List<FuelType>? fuelTypes;
    private List<FuelStation>? fuelStations;

    protected override async Task OnInitializedAsync()
    {
        fuelEntries = (await FuelEntryService.GetAllAsync()).ToList();
        cars = (await CarService.GetAllAsync()).ToList();
        fuelTypes = (await FuelTypeService.GetAllAsync()).ToList();
        fuelStations = (await FuelStationService.GetAllAsync()).ToList();
    }

    private string GetCarName(Guid carId) => cars?.FirstOrDefault(c => c.Id == carId)?.Name ?? "Unknown";
    private string GetFuelTypeName(Guid fuelTypeId) => fuelTypes?.FirstOrDefault(f => f.Id == fuelTypeId)?.Name ?? "Unknown";
    private string GetFuelStationName(Guid stationId) => fuelStations?.FirstOrDefault(s => s.Id == stationId)?.Name ?? "Unknown";

    private async Task DeleteFuelEntry(Guid id)
    {
        await FuelEntryService.DeleteAsync(id);
        fuelEntries = (await FuelEntryService.GetAllAsync()).ToList();
    }
}
