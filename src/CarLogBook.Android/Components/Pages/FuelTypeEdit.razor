@page "/fueltypes/edit/{Id:guid}"
@inject IFuelTypeService FuelTypeService
@inject NavigationManager Navigation

<h3>@(isNew ? "Add Fuel Type" : "Edit Fuel Type")</h3>

@if (fuelType == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="fuelType" OnValidSubmit="HandleValidSubmit">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="fuelType.Name" />
        </div>
        
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private FuelType fuelType = new() { Id = Guid.NewGuid(), Name = "" };
    private bool isNew;

    protected override async Task OnInitializedAsync()
    {
        isNew = Id == Guid.Empty || Id == new Guid();
        
        if (!isNew)
        {
            var existing = await FuelTypeService.GetByIdAsync(Id);
            if (existing != null)
            {
                fuelType = new FuelType { Id = existing.Id, Name = existing.Name };
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isNew)
        {
            await FuelTypeService.CreateAsync(fuelType);
        }
        else
        {
            await FuelTypeService.UpdateAsync(fuelType);
        }

        Navigation.NavigateTo("/fueltypes");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/fueltypes");
    }
}
